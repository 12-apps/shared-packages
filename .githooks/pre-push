#!/usr/bin/env sh
# Lint the commit messages being pushed, with the rules CI lints them with.
#
# CI runs commitlint over a PR's commits in `.github/workflows/commitlint.yml`,
# a whole push-and-wait away from the commit. A `commit-msg` hook would not be
# enough: a merge made with `git merge -m`, or a commit written with
# `git commit-tree`, runs no commit hook at all. Every commit passes through a
# push, so this checks there. #606 is the case it exists for: a merge commit
# whose body line ran past 100 characters reached the remote and failed CI.
#
# The rules are `commitlint.config.mjs`, the same file CI reads through
# `config-path`, so this hook cannot pass what CI would refuse or refuse what
# CI would pass.
#
# The range is CI's: from the merge base with `origin/main` to the pushed
# commit. So commits already on main are never linted again. It reads the LOCAL
# remote-tracking ref and never fetches.
#
# SKIP_PREPUSH=1 opts out, as the other 12-apps repositories' hooks do.
set -u

[ "${SKIP_PREPUSH:-}" = "1" ] && exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

COMMITLINT=node_modules/.bin/commitlint
ZERO=0000000000000000000000000000000000000000
failed=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # A deletion pushes no commits, so there is nothing to lint.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ ! -x "$COMMITLINT" ]; then
    echo "[pre-push] commitlint is not installed. Run pnpm install, or push with SKIP_PREPUSH=1."
    exit 1
  fi

  base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  printf '[pre-push] commit messages… '
  if [ -n "$base" ]; then
    output="$("$COMMITLINT" --config commitlint.config.mjs --from "$base" --to "$local_sha" 2>&1)"
    status=$?
  else
    # No origin/main to anchor on (a fresh single-branch clone): lint the tip,
    # which beats skipping in silence.
    output="$(git log -1 --format=%B "$local_sha" | "$COMMITLINT" --config commitlint.config.mjs 2>&1)"
    status=$?
  fi
  if [ "$status" -eq 0 ]; then
    echo 'ok'
  else
    echo 'FAILED'
    echo
    printf '%s\n' "$output"
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo
  echo "[pre-push] CI would refuse these messages. Reword them, or push with SKIP_PREPUSH=1 if you know better."
  exit 1
fi
exit 0
