#!/usr/bin/env sh
# Lint the commit messages being pushed, with the rules CI lints them with.
#
# CI runs commitlint over a PR's commits in `.github/workflows/commitlint.yml`,
# a whole push-and-wait away from the commit. A `commit-msg` hook would not be
# enough: a merge made with `git merge -m`, or a commit written with
# `git commit-tree`, runs no commit hook at all. Every commit passes through a
# push, so this checks there. #606 is the case it exists for: a merge commit
# whose body line ran past 100 characters reached the remote and failed CI.
#
# The rules are `commitlint.config.mjs`, the file CI reads through
# `config-path`, and REQUIRE_ISSUE_REF is pinned to the `false` CI runs them
# with, so a value left in a shell cannot refuse a message CI passes.
#
# What it lints: a pushed BRANCH, from its merge base with `origin/main` to the
# pushed commit, in one `commitlint --from --to` run, as CI lints a pull
# request. It reads the LOCAL remote-tracking ref and never fetches, so a stale
# `origin/main` can put commits main already has in the range. Without
# `origin/main` (a single-branch clone) it lints, one by one, every pushed
# commit that no remote-tracking ref holds, and with no remote-tracking ref at
# all, the pushed commit alone.
#
# What it lets through, and why each is safe:
#   - a deletion, which pushes no commits;
#   - a tag or a notes ref. Neither belongs to a pull request, so CI never lints
#     them, and the release job pushes both: semantic-release tags the release
#     commit and pushes `refs/notes/semantic-release-*`. `prepare` does not
#     turn this hook on under CI either;
#   - a branch holding nothing main does not already have.
#
# What it cannot see: the pull request's TITLE, which CI lints too and a squash
# merge lands as the commit on main.
#
# SKIP_PREPUSH=1 opts out, as the other 12-apps repositories' hooks do.
set -u

[ "${SKIP_PREPUSH:-}" = "1" ] && exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

COMMITLINT=node_modules/.bin/commitlint
ZERO=0000000000000000000000000000000000000000
failed=0

commitlint() {
  REQUIRE_ISSUE_REF=false "$COMMITLINT" --config commitlint.config.mjs "$@"
}

require_commitlint() {
  if [ ! -x "$COMMITLINT" ]; then
    echo "[pre-push] commitlint is not installed. Run pnpm install, or push with SKIP_PREPUSH=1."
    exit 1
  fi
}

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  if [ -n "$base" ]; then
    [ "$(git rev-list --count "$base..$local_sha")" -eq 0 ] && continue
    require_commitlint
    printf '[pre-push] commit messages on %s… ' "${remote_ref#refs/heads/}"
    if report="$(commitlint --from "$base" --to "$local_sha" 2>&1)"; then
      report=""
    fi
  else
    if [ -n "$(git for-each-ref --count=1 refs/remotes)" ]; then
      commits="$(git rev-list --reverse "$local_sha" --not --remotes)"
    else
      commits="$local_sha"
    fi
    [ -z "$commits" ] && continue
    require_commitlint
    printf '[pre-push] commit messages on %s… ' "${remote_ref#refs/heads/}"
    report=""
    for sha in $commits; do
      if ! output="$(git log -1 --format=%B "$sha" | commitlint 2>&1)"; then
        report="$report
$(git log -1 --format='%h %s' "$sha")
$output
"
      fi
    done
  fi

  if [ -z "$report" ]; then
    echo 'ok'
  else
    echo 'FAILED'
    printf '%s\n' "$report"
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "[pre-push] CI would refuse these messages. Reword them, or push with SKIP_PREPUSH=1 if you know better."
  exit 1
fi
exit 0
