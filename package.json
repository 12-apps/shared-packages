{
  "name": "@12-apps/shared-packages",
  "version": "1.0.0",
  "description": "Shared packages for 12-apps",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "quality": "pnpm quality:complexity && pnpm quality:flakiness && pnpm quality:portability",
    "quality:complexity": "eslint --config eslint.complexity.config.mjs .",
    "quality:flakiness": "eslint --config eslint.flakiness.config.mjs .",
    "quality:portability": "pnpm quality:portability:selftest && eslint --config eslint.payments-portability.config.mjs .",
    "quality:portability:selftest": "node scripts/payments-portability-selftest.mjs",
    "quality:dup": "jscpd --min-tokens 50 --threshold 3 --gitignore --reporters consoleFull --format \"typescript,tsx,javascript,jsx\" --ignore \"**/*.test.*,**/*.spec.*,**/tests/**,**/__tests__/**,**/*.stories.*,**/generated/**,**/*.d.ts,**/dist/**,**/build/**,**/.turbo/**,**/coverage/**,**/storybook-static/**\" .",
    "quality:knip": "node scripts/knip-gate.mjs",
    "quality:knip:update": "node scripts/knip-gate.mjs --update",
    "quality:quarantine": "node scripts/flaky-quarantine-check.mjs",
    "bdd:gen": "cd harness/frontend && npx bddgen test",
    "test:bdd": "cd harness/frontend && npx bddgen test && npx playwright test --project=journeys",
    "quality:bdd": "node scripts/bdd-gate.mjs",
    "quality:all": "pnpm quality && pnpm quality:dup && pnpm quality:quarantine && pnpm quality:knip && pnpm quality:bdd"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "globals": "^16.5.0",
    "jscpd": "^4.0.5",
    "jsdom": "^26.1.0",
    "knip": "^5.66.0",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "turbo": "^2.7.2",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "private": true
}
