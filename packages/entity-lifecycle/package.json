{
  "name": "@12-apps/entity-lifecycle",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Generic, portable entity-lifecycle plugin: diff-based version history with restore + retention, recycle-bin soft delete, per-item drafts and change approvals. Framework-free core, host-mounted backend surface (./server: versions/restore/drafts/recycle-bin/approvals endpoints GENERATED per registered collection, duck-typed Prisma seam), Hono adapter (./hono), React screens (./react: Lixeira, Aprova\u00e7\u00f5es, version-history dialog, draft banner) and the package-owned Prisma partial + migrations. Standardized adoption contract in ADOPTING.md.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./hono": "./src/hono/index.ts",
    "./react": "./src/react/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./manifest/server": "./src/manifest/server.ts",
    "./manifest/web": "./src/manifest/web.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf node_modules coverage storybook-static",
    "dev": "storybook dev -p 6008",
    "lint": "eslint src --max-warnings 0",
    "prisma:sync": "node scripts/sync-entity-lifecycle-schema.mjs",
    "prisma:sync:check": "node scripts/sync-entity-lifecycle-schema.mjs --check",
    "storybook:build": "storybook build",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@12-apps/ui": "workspace:*"
  },
  "peerDependencies": {
    "@12-apps/mcp": ">=3.4.0",
    "@12-apps/wiring": ">=1.3.0",
    "hono": ">=4.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@12-apps/mcp": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@12-apps/wiring": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/i18n": "workspace:*",
    "@12-apps/mcp": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@12-apps/wiring": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.5.0",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/builder-vite": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@testing-library/react": "^16.1.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "9.1.10",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "hono": "^4.6.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^9.1.10",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "zod": "^4.3.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/entity-lifecycle"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "scripts",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*",
    "!**/__stories__/**"
  ],
  "wiring": {
    "db": {
      "partial": "prisma/entity-lifecycle.prisma",
      "migrations": "prisma/migrations"
    }
  }
}
