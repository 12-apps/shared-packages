{
  "name": "@12-apps/scales",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Model profiles and serial transports for scales with stable weight reporting.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./android": {
      "types": "./dist/android.d.ts",
      "default": "./dist/android.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/scales"
  },
  "files": [
    "dist",
    "ADOPTING.md"
  ]
}
