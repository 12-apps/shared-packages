{
  "name": "@12-apps/realtime",
  "version": "1.0.0",
  "type": "module",
  "description": "Generic, portable realtime EVENT SYSTEM. Framework-free core (typed topic/event envelopes and a publish/subscribe bus behind a swappable driver port: Redis pub/sub across processes, inline in-process for dev and tests), host-mounted backend surface (./server: topic registry, subscribe authorization seam, SSE transport, connection tickets, per-subject connection caps and the transactional outbox), Hono adapter (./hono), a runnable WebSocket gateway (./gateway plus a realtime-gateway bin), the browser half (./react: createWebEvents — client, reconnect policy with jitter, ws->sse demotion, liveness watch, cross-tab SharedWorker and React hooks), the SharedWorker body (./worker), the publisher-parity gate (./parity) and the package-owned Prisma partial + migrations. Standardized adoption contract in ADOPTING.md.",
  "exports": {
    ".": "./src/index.ts",
    "./redis": "./src/drivers/redis.ts",
    "./ticket": "./src/core/ticket.ts",
    "./server": "./src/server/index.ts",
    "./hono": "./src/hono/index.ts",
    "./gateway": "./src/gateway/index.ts",
    "./react": "./src/react/index.ts",
    "./worker": "./src/react/worker/entry.ts",
    "./parity": "./src/parity/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "realtime-gateway": "./bin/realtime-gateway.mjs"
  },
  "scripts": {
    "clean": "rm -rf node_modules coverage",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:sync": "node scripts/sync-realtime-schema.mjs",
    "prisma:sync:check": "node scripts/sync-realtime-schema.mjs --check"
  },
  "dependencies": {
    "ioredis": "^5.11.1"
  },
  "peerDependencies": {
    "hono": ">=4.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tsx": ">=4.0.0",
    "ws": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tsx": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "^1.20.0",
    "@12-apps/typescript-config": "^1.20.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "hono": "^4.6.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/realtime"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "scripts",
    "bin",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*"
  ]
}
