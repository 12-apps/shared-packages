{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@12-apps/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist/e2e",
    "rootDir": "src/e2e",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/e2e/**/*"],
  // The suites beside these helpers are vitest's, and this config compiles what
  // ships: leaving them in would emit them into `dist/e2e` and make the
  // published journeys' BUILD depend on a test runner no consumer installs.
  "exclude": ["node_modules", "dist", "src/e2e/**/__tests__/**", "src/e2e/**/*.test.ts"]
}
