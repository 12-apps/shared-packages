{
  "name": "@12-apps/report-builder",
  "version": "1.0.0",
  "type": "module",
  "description": "Plug-and-play reporting plugin (FUT-302): spec engine (.), host-mounted backend surface (./server: catalog, presets, policy, duck-typed Prisma adapter/stores, wire schemas) and reports UI (./react), plus the package-owned Prisma fragment synced into the host schema. Standardized adoption contract in ADOPTING.md.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./react": "./src/react/index.ts",
    "./hono": "./src/hono/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules coverage",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:sync": "node scripts/sync-report-builder-schema.mjs",
    "prisma:sync:check": "node scripts/sync-report-builder-schema.mjs --check"
  },
  "dependencies": {
    "@12-apps/stock-domain": "workspace:*",
    "@12-apps/ui": "workspace:*",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "hono": "^4.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": ">=6.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/report-builder"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*"
  ]
}
