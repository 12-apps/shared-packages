{
  "name": "@12-apps/shared-helpers",
  "version": "1.0.0",
  "description": "Shared helper utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "require": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "require": "./dist/prisma/index.js",
      "default": "./dist/prisma/index.js"
    }
  },
  "scripts": {
    "trigger": "pnpm -r --filter ./packages/** run build",
    "build": "node scripts/sync-lifecycle-schema.mjs && node scripts/sync-research-schema.mjs && node scripts/sync-shift-schema.mjs --check && node scripts/sync-prisma-plugins.mjs --check && prisma generate && tsc",
    "clean": "rm -rf dist node_modules coverage",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint:files": "bash -c 'eslint \"${@:-.}\" --max-warnings 0' _",
    "lint": "pnpm run lint:files .",
    "lint:fix": "bash -c 'eslint \"${@:-.}\" --max-warnings 0 --fix' _",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node scripts/sync-lifecycle-schema.mjs && node scripts/sync-research-schema.mjs && node scripts/sync-shift-schema.mjs --check && node scripts/sync-prisma-plugins.mjs --check && prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:sync-lifecycle": "node scripts/sync-lifecycle-schema.mjs",
    "prisma:sync-research": "node scripts/sync-research-schema.mjs",
    "prisma:sync-shift": "node scripts/sync-shift-schema.mjs",
    "prisma:sync-shift:check": "node scripts/sync-shift-schema.mjs --check",
    "prisma:sync-plugins": "node scripts/sync-prisma-plugins.mjs",
    "prisma:sync-plugins:check": "node scripts/sync-prisma-plugins.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.972.0",
    "@electric-sql/pglite": "0.2.17",
    "@maxmind/geoip2-node": "^6.3.4",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sentry/node": "^10.69.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.11.1",
    "jwt-decode": "^4.0.0",
    "pg": "^8.16.3",
    "pglite-prisma-adapter": "0.7.2",
    "undici": "^6.21.3",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@12-apps/entity-lifecycle": "workspace:*",
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/payments-backend": "workspace:*",
    "@12-apps/product-research": "workspace:*",
    "@12-apps/report-builder": "workspace:*",
    "@12-apps/shift": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "prisma": "7.8.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "environment",
    "config",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/shared-helpers"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "*.js",
    "*.mjs",
    "*.md"
  ]
}
