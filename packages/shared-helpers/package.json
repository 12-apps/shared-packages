{
  "name": "@12-apps/shared-helpers",
  "version": "1.0.0",
  "description": "Shared helper utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "require": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "trigger": "pnpm -r --filter ./packages/** run build",
    "build": "tsc",
    "clean": "rm -rf dist node_modules coverage",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint:files": "bash -c 'eslint \"${@:-.}\" --max-warnings 0' _",
    "lint": "pnpm run lint:files .",
    "lint:fix": "bash -c 'eslint \"${@:-.}\" --max-warnings 0 --fix' _",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@12-apps/observability-backend": "workspace:*",
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.972.0",
    "@maxmind/geoip2-node": "^6.3.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.11.1",
    "jwt-decode": "^4.0.0",
    "pg": "^8.16.3",
    "undici": "^6.21.3",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@sentry/node": "^10.69.0",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "environment",
    "config",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/shared-helpers"
  },
  "files": [
    "src",
    "dist",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*"
  ]
}
