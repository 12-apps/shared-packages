{
  "name": "@12-apps/entitlements",
  "version": "1.0.0",
  "type": "module",
  "description": "Generic, portable plan/feature entitlements: layered resolution (code/plan/status/tenant), numeric quotas, per-feature revoke policy and 402-vs-403 denial semantics. Framework-free core plus createApiEntitlements (./server, ./hono adapter) and createWebEntitlements (./react). Knows nothing about money. Zero app coupling.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./react": "./src/react/index.ts",
    "./hono": "./src/hono/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./manifest/server": "./src/manifest/server.ts",
    "./manifest/web": "./src/manifest/web.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf node_modules coverage",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:sync": "node scripts/sync-entitlements-schema.mjs",
    "prisma:sync:check": "node scripts/sync-entitlements-schema.mjs --check"
  },
  "peerDependencies": {
    "@12-apps/wiring": ">=1.3.0",
    "hono": ">=4.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@12-apps/wiring": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/i18n": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@12-apps/wiring": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "hono": "^4.6.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/entitlements"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "scripts",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*"
  ],
  "dependencies": {
    "@12-apps/ui": "workspace:*"
  },
  "wiring": {
    "db": {
      "partial": "prisma/entitlements.prisma",
      "migrations": "prisma/migrations"
    }
  }
}
