{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@12-apps/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist/e2e",
    "rootDir": "src/e2e",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/e2e/**/*"],
  "exclude": ["node_modules", "dist", "src/e2e/**/__tests__/**", "src/e2e/**/*.test.ts"]
}
