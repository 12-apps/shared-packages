{
  "name": "@12-apps/discounts",
  "version": "1.0.0",
  "type": "module",
  "description": "The discount/promotion domain: a host-agnostic evaluator (percentage or fixed amount, order/category/item scope, automatic or coupon-triggered, stacking and exclusivity, integer-cent allocation) plus the admin CRUD surface as wiring-contract route descriptors over a store port. No database, no framework, no baked user copy.",
  "exports": {
    ".": "./src/index.ts",
    "./pt-BR": "./src/engine/pt-BR.ts",
    "./server": "./src/server/index.ts",
    "./server/pt-BR": "./src/server/pt-BR.ts",
    "./react": "./src/react/index.ts",
    "./react/pt-BR": "./src/react/pt-BR.ts",
    "./manifest": "./src/manifest/index.ts",
    "./manifest/server": "./src/manifest/server.ts",
    "./manifest/web": "./src/manifest/web.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf node_modules coverage dist",
    "dev": "storybook dev -p 6009",
    "lint": "eslint src --max-warnings 0",
    "prisma:sync": "node scripts/sync-discounts-schema.mjs",
    "prisma:sync:check": "node scripts/sync-discounts-schema.mjs --check",
    "storybook:build": "storybook build",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@12-apps/app-shell": "workspace:*",
    "@12-apps/shared-helpers": "workspace:*",
    "@12-apps/ui": "workspace:*",
    "zod": "^4.3.5"
  },
  "peerDependencies": {
    "@12-apps/wiring": ">=1.3.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router-dom": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@12-apps/wiring": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/forms-core": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@12-apps/wiring": "workspace:*",
    "@electric-sql/pglite": "^0.2.17",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "9.1.10",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0",
    "storybook": "^9.1.10",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/discounts"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "prisma",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*",
    "!**/__stories__/**"
  ],
  "wiring": {
    "db": {
      "partial": "prisma/discounts.prisma",
      "migrations": "prisma/migrations"
    }
  }
}
