{
  "name": "@12-apps/marketplace",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "One marketplace integration engine for every marketplace: the durable inbox, the ingest pipeline, the acceptance clock and its sweep, the SKU map, the integration settings with sealed credentials, and the outbound engine (confirm, cancellation request, retries), behind an adapter port. Each marketplace is an adapter at its own subpath (./ifood). Framework-neutral wiring route descriptors (./server) with a Hono adapter (./hono), dep-free job blueprints, MCP tools and the package-owned Prisma partial + migrations.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ifood": {
      "types": "./dist/ifood/index.d.ts",
      "default": "./dist/ifood/index.js"
    },
    "./ifood/pt-BR": {
      "types": "./dist/ifood/pt-BR.d.ts",
      "default": "./dist/ifood/pt-BR.js"
    },
    "./ifood/en-US": {
      "types": "./dist/ifood/en-US.d.ts",
      "default": "./dist/ifood/en-US.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/pt-BR": {
      "types": "./dist/server/pt-BR.d.ts",
      "default": "./dist/server/pt-BR.js"
    },
    "./server/en-US": {
      "types": "./dist/server/en-US.d.ts",
      "default": "./dist/server/en-US.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./manifest/server": {
      "types": "./dist/manifest/server.d.ts",
      "default": "./dist/manifest/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "clean": "rm -rf node_modules coverage dist",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "peerDependencies": {
    "@12-apps/wiring": ">=1.3.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@12-apps/wiring": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@12-apps/wiring": "workspace:*",
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.6",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "hono": "^4.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/marketplace"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!tsup.config.ts",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "wiring": {
    "db": {
      "partial": "prisma/marketplace.prisma",
      "migrations": "prisma/migrations"
    }
  }
}
