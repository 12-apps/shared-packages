{
  "name": "@12-apps/rbac",
  "version": "1.0.0",
  "type": "module",
  "description": "Generic, portable Role-Based Access Control. Framework-free core (engine, registry, caveats, templates, governance), host-mounted backend surface (./server: role CRUD, permissions, team roster, guard helpers, duck-typed Prisma seam), Hono adapter (./hono), React screens + <Can> (./react), the rbac:coverage gate (./coverage) and the package-owned Prisma partial + migrations. Standardized adoption contract in ADOPTING.md.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./coverage": {
      "types": "./dist/coverage-gate/index.d.ts",
      "default": "./dist/coverage-gate/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./manifest/server": {
      "types": "./dist/manifest/server.d.ts",
      "default": "./dist/manifest/server.js"
    },
    "./manifest/web": {
      "types": "./dist/manifest/web.d.ts",
      "default": "./dist/manifest/web.js"
    },
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    },
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "import": "./dist/e2e/index.js",
      "default": "./dist/e2e/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "clean": "rm -rf node_modules coverage",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:sync": "node scripts/sync-rbac-schema.mjs",
    "prisma:sync:check": "node scripts/sync-rbac-schema.mjs --check"
  },
  "peerDependencies": {
    "@12-apps/wiring": ">=1.3.0",
    "@playwright/test": ">=1.55.0",
    "hono": ">=4.0.0",
    "playwright-bdd": ">=8.3.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@12-apps/wiring": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "playwright-bdd": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/i18n": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@12-apps/wiring": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "hono": "^4.6.0",
    "jsdom": "^25.0.1",
    "playwright-bdd": "^9.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/rbac"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "scripts",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!tsup.config.ts",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*",
    "features"
  ],
  "dependencies": {
    "@12-apps/ui": "workspace:*",
    "zod": "^4.3.5"
  },
  "wiring": {
    "db": {
      "partial": "prisma/rbac.prisma",
      "migrations": "prisma/migrations"
    }
  }
}
