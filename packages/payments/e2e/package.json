{
  "name": "@12-apps/payments-e2e",
  "version": "1.0.0",
  "type": "module",
  "description": "The payments buyer journeys, as Gherkin a host runs against its own app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/payments/e2e"
  },
  "files": [
    "dist",
    "features",
    "features-platform",
    "*.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf node_modules dist",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "playwright-bdd": ">=8.0.0"
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@playwright/test": "^1.56.1",
    "playwright-bdd": "^8.4.1",
    "typescript": "5.9.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
