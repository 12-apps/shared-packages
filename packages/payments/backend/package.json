{
  "name": "@12-apps/payments-backend",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Server half of the vendor-agnostic payments platform: normalized charge/refund/webhook model behind per-provider adapters (Stone, InfinitePay, Stripe, ...), merchant-scoped credential settings with masking, fetch-native HTTP handlers, hexagonal storage ports with in-memory and Prisma adapters, and a self-owned Prisma schema fragment + migration. Framework-free; deployable inside a host app today or as a standalone payments microservice later. Zero app coupling.",
  "exports": {
    ".": "./src/index.ts",
    "./jobs": "./src/jobs/index.ts",
    "./pagbank-legacy-notifications": "./src/providers/pagbank-legacy-notifications.ts",
    "./pagbank-webhook-signer": "./src/providers/pagbank-webhook-signer.ts",
    "./providers/pagbank": "./src/providers/pagbank.ts",
    "./providers/stone": "./src/providers/stone.ts",
    "./providers/infinitepay": "./src/providers/infinitepay.ts",
    "./providers/stripe": "./src/providers/stripe.ts",
    "./pagbank-public-key": "./src/providers/pagbank-public-key.ts",
    "./manifest": "./src/manifest/index.ts",
    "./manifest/server": "./src/manifest/server.ts",
    "./locales": "./src/locales.ts",
    "./package.json": "./package.json"
  },
  "wiring": {
    "db": {
      "partial": "prisma/payments.prisma",
      "migrations": "prisma/migrations"
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules coverage",
    "test": "node ../../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:sync": "node scripts/sync-payments-schema.mjs",
    "prisma:sync:check": "node scripts/sync-payments-schema.mjs --check"
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/payments/backend"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*"
  ]
}
