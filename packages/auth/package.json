{
  "name": "@12-apps/auth",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Plug-and-play authentication plugin: Auth.js wiring and the e-mail + password flow (.), host-mounted backend surface (./server: routes, messages, mail templates, the duck-typed credential and settings store seams), auth UI (./react: screens, whole login/sign-up pages, the platform settings screen), a Hono mount (./hono), delivery through @12-apps/notifications (./notifications) and packaged Gherkin journeys (./e2e) \u2014 plus the package-owned Prisma fragment synced into the host schema. Who the users are is the host's and arrives as config. Adoption contract in ADOPTING.md.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./react": "./src/react/index.ts",
    "./hono": "./src/hono/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./manifest/server": "./src/manifest/server.ts",
    "./manifest/web": "./src/manifest/web.tsx",
    "./notifications": {
      "types": "./src/notifications/index.ts",
      "default": "./src/notifications/index.ts"
    },
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "default": "./dist/e2e/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest",
    "test:coverage": "node ../../scripts/vitest-with-teardown.mjs run --coverage",
    "dev": "storybook dev -p 6008",
    "storybook:build": "storybook build",
    "build": "tsc -p tsconfig.e2e.json",
    "prisma:sync": "node scripts/sync-auth-schema.mjs",
    "prisma:sync:check": "node scripts/sync-auth-schema.mjs --check",
    "clean": "rm -rf node_modules coverage dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@12-apps/wiring": "workspace:*",
    "@auth/core": "0.41.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/notifications": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@12-apps/ui": "workspace:*",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "9.1.10",
    "eslint-plugin-test-flakiness": "^1.8.0",
    "hono": "^4.6.0",
    "jsdom": "^25.0.1",
    "playwright-bdd": "^8.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^9.1.10",
    "typescript": "5.9.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/auth"
  },
  "files": [
    "src",
    "features",
    "dist",
    "prisma",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*",
    "scripts"
  ],
  "peerDependencies": {
    "@12-apps/ui": ">=5.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "hono": ">=4.0.0",
    "@playwright/test": ">=1.40.0",
    "playwright-bdd": ">=8.0.0",
    "@12-apps/notifications": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@12-apps/ui": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "playwright-bdd": {
      "optional": true
    },
    "@12-apps/notifications": {
      "optional": true
    }
  }
}
