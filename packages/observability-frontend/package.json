{
  "name": "@12-apps/observability-frontend",
  "version": "1.0.0",
  "type": "module",
  "description": "Browser error reporting for a React SPA, on Sentry: deferred init behind a served DSN, the noise rules that keep a deploy from filing one issue per open tab, a PII scrub, a route error boundary and a self-check page that proves the chain is live in the deployed bundle. Host-agnostic \u2014 what an app-specific error looks like, what a crashed page renders and where the config lives all arrive through named seams.",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./self-check": "./src/react/self-check.tsx",
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./service-worker": {
      "types": "./dist/observability-sw.d.ts",
      "default": "./dist/observability-sw.global.js"
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules coverage dist",
    "build": "tsup",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@12-apps/ui": "workspace:*",
    "@sentry/react": "^10.69.0",
    "@sentry/vite-plugin": "^5.4.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router-dom": ">=7.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/observability-frontend"
  },
  "files": [
    "src",
    "dist",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!tsup.config.ts",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*"
  ]
}
