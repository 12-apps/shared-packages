{
  "name": "@12-apps/qr",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "QR codes in both directions: print-ready sticker artwork a gráfica can run — trim/bleed boxes, crop marks, K-only black, error-correction H (./pdf) — and reading one back through a device camera, native BarcodeDetector where it exists and a lazily-imported jsQR everywhere else (./scan).",
  "exports": {
    "./pdf": "./src/pdf/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf node_modules coverage dist",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/qr"
  },
  "files": [
    "src",
    "dist",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/*.test.*"
  ]
}
