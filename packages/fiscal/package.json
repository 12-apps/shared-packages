{
  "name": "@12-apps/fiscal",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Brazilian consumption-tax machinery for any host that sells. Its first module is the IBS/CBS engine (./engine): a pure function from priced lines, the seller's regime, the destination, the exclusions, a versioned rate table and the date of the supply to a per-line and per-order breakdown, with the NF-e layout's per-item rounding and an injected official-calculator port for running it as an oracle. Rate tables are versioned data (./tables/*). Implements @12-apps/wiring (./manifest).",
  "exports": {
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./sale": {
      "types": "./dist/sale/index.d.ts",
      "default": "./dist/sale/index.js"
    },
    "./sidecar": {
      "types": "./dist/sidecar/index.d.ts",
      "default": "./dist/sidecar/index.js"
    },
    "./sidecar/schema/*": "./sidecar/schema/*",
    "./tables/*": "./tables/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "clean": "rm -rf node_modules coverage dist",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@12-apps/wiring": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@12-apps/wiring": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@12-apps/wiring": "workspace:*",
    "@types/node": "^22.10.6",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/fiscal"
  },
  "files": [
    "src",
    "dist",
    "tables",
    "sidecar",
    "*.md",
    "!eslint.config.js",
    "!tsup.config.ts",
    "!**/__tests__/**",
    "!**/*.test.*",
    "!sidecar/vendor",
    "!sidecar/tests",
    "!sidecar/phpunit.xml",
    "!sidecar/.phpunit.cache"
  ]
}
