{
  "name": "@12-apps/fiscal",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Brazilian consumption-tax machinery and fiscal documents for any host that sells. The IBS/CBS engine (./engine): a pure function from priced lines, the seller's regime, the destination, the exclusions, a versioned rate table and the date of the supply to a per-line and per-order breakdown. The neutral sale document (./sale) and a stateless HTTP service over sped-nfe that issues NF-e and NFC-e, shipped with its Dockerfile in sidecar/ (./sidecar types its wire contract). The fiscal document module (./documents): the state machine, the per-series number counters, the issuer port and its sidecar adapter (./issuer), the signing identity, and the DANFE NFC-e as ESC/POS-ready lines (./danfe). Implements @12-apps/wiring (./manifest): db, http, jobs, permissions.",
  "exports": {
    "./danfe": {
      "types": "./dist/danfe/index.d.ts",
      "default": "./dist/danfe/index.js"
    },
    "./danfe/pt-BR": {
      "types": "./dist/danfe/pt-BR.d.ts",
      "default": "./dist/danfe/pt-BR.js"
    },
    "./documents": {
      "types": "./dist/documents/index.d.ts",
      "default": "./dist/documents/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./issuer": {
      "types": "./dist/issuer/index.d.ts",
      "default": "./dist/issuer/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./manifest/server": {
      "types": "./dist/manifest/server.d.ts",
      "default": "./dist/manifest/server.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "default": "./dist/notifications.js"
    },
    "./sale": {
      "types": "./dist/sale/index.d.ts",
      "default": "./dist/sale/index.js"
    },
    "./sidecar": {
      "types": "./dist/sidecar/index.d.ts",
      "default": "./dist/sidecar/index.js"
    },
    "./sidecar/schema/*": "./sidecar/schema/*",
    "./tables/*": "./tables/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "clean": "rm -rf node_modules coverage dist",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@12-apps/wiring": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@12-apps/wiring": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@12-apps/wiring": "workspace:*",
    "@electric-sql/pglite": "0.2.17",
    "@types/node": "^22.10.6",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/fiscal"
  },
  "files": [
    "src",
    "dist",
    "tables",
    "sidecar",
    "prisma",
    "*.md",
    "!eslint.config.js",
    "!tsup.config.ts",
    "!**/__tests__/**",
    "!**/*.test.*",
    "!sidecar/vendor",
    "!sidecar/tests",
    "!sidecar/phpunit.xml",
    "!sidecar/.phpunit.cache"
  ],
  "wiring": {
    "db": {
      "partial": "prisma/fiscal.prisma",
      "migrations": "prisma/migrations"
    }
  }
}
