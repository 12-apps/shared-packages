  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "storybook dev -p 6006",
    "build": "tsup && pnpm build:types && pnpm exports:check",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "exports:sync": "node scripts/sync-exports.mjs",
    "exports:check": "node scripts/sync-exports.mjs --check",
    "clean": "rm -rf dist storybook-static",
    "storybook:build": "storybook build",
    "storybook:serve": "http-server storybook-static -p 6008 --silent",
    "storybook:test": "test-storybook --maxWorkers=4 --url http://localhost:6008",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest",
    "test:coverage": "node ../../scripts/vitest-with-teardown.mjs run --coverage",
