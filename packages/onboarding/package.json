{
  "name": "@12-apps/onboarding",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Reusable guided onboarding: React provider + GuidedSection and the API-bound OnboardingStore (.), the host-mounted progress surface (./server: createApiOnboarding \u2014 GET/PATCH progress with save/dismiss/reset), a Hono adapter (./hono), and the package-owned Prisma partial + migration for OnboardingState. Standardized adoption contract in ADOPTING.md.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./hono": "./src/hono/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf node_modules coverage",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:sync": "node scripts/sync-onboarding-schema.mjs",
    "prisma:sync:check": "node scripts/sync-onboarding-schema.mjs --check"
  },
  "dependencies": {
    "@12-apps/ui": "workspace:*",
    "react": "^19.2.0"
  },
  "peerDependencies": {
    "hono": ">=4.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@types/react": "19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "hono": "^4.6.0",
    "jsdom": "^25.0.1",
    "react-dom": "^19.2.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/onboarding"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "scripts",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*"
  ]
}
