{
  "name": "@12-apps/onboarding",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Reusable guided onboarding: React provider + GuidedSection and the API-bound OnboardingStore (.), the host-mounted progress surface (./server: createApiOnboarding \u2014 GET/PATCH progress with save/dismiss/reset), a Hono adapter (./hono), and the package-owned Prisma partial + migration for OnboardingState. Standardized adoption contract in ADOPTING.md.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./manifest/server": {
      "types": "./dist/manifest/server.d.ts",
      "default": "./dist/manifest/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "clean": "rm -rf node_modules coverage",
    "test": "node ../../scripts/vitest-with-teardown.mjs run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:sync": "node scripts/sync-onboarding-schema.mjs",
    "prisma:sync:check": "node scripts/sync-onboarding-schema.mjs --check"
  },
  "dependencies": {
    "@12-apps/ui": "workspace:*",
    "react": "^19.2.0"
  },
  "peerDependencies": {
    "@12-apps/wiring": ">=1.3.0",
    "hono": ">=4.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@12-apps/eslint-config": "workspace:*",
    "@12-apps/typescript-config": "workspace:*",
    "@12-apps/wiring": "workspace:*",
    "@types/react": "19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-test-flakiness": "^1.4.0",
    "hono": "^4.6.0",
    "jsdom": "^25.0.1",
    "react-dom": "^19.2.0",
    "tsup": "^8.0.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12-apps/shared-packages.git",
    "directory": "packages/onboarding"
  },
  "files": [
    "src",
    "dist",
    "prisma",
    "scripts",
    "*.js",
    "*.mjs",
    "*.md",
    "!eslint.config.js",
    "!tsup.config.ts",
    "!**/__tests__/**",
    "!**/tests/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.stories.*",
    "!**/*.test-story.*",
    "!**/test-helpers.*"
  ],
  "wiring": {
    "db": {
      "partial": "prisma/onboarding.prisma",
      "migrations": "prisma/migrations"
    }
  }
}
