{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "duplicates": "off"
  },
  "ignore": [
    "**/generated/**",
    "**/*.d.ts",
    "// Schema partials are consumed by scripts/sync-*-schema.mjs, which COPY",
    "// them by path rather than importing them, so knip cannot see the edge",
    "// and reports every partial as an unused file.",
    "**/prisma/*.prisma",
    "// harness/ is a CONSUMER fixture, not shipped code. Its package.json is",
    "// generated by scripts/harness-install.mjs (and gitignored), and its files",
    "// are entry points reached by vite/playwright config rather than by any",
    "// import knip can follow \u2014 so every one of them reads as unused here.",
    "harness/**",
    "// The payments-portability gate's proof material: deliberate rule",
    "// violations linted through the real config by",
    "// scripts/payments-portability-selftest.mjs under a pretend file path.",
    "// Nothing imports them \u2014 that is the point \u2014 so knip reads every one",
    "// as an unused file.",
    "scripts/payments-portability-fixtures/**"
  ],
  "ignoreBinaries": [
    "only-allow"
  ],
  "ignoreDependencies": [],
  "workspaces": {
    ".": {
      "entry": [
        "eslint.complexity.config.mjs",
        "eslint.flakiness.config.mjs",
        "eslint.payments-portability.config.mjs",
        "eslint.payments-portability.rules.mjs",
        "eslint.config.mjs",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "@eslint/js",
        "eslint-config-prettier",
        "typescript-eslint",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/index.ts",
        "src/**/index.ts",
        "src/**/*.stories.{ts,tsx}",
        "src/components/**/*.tsx",
        "src/components/**/*.types.ts",
        "src/mui/*.ts",
        "src/utils/index.ts",
        "scripts/*.js"
      ],
      "ignoreDependencies": [
        "@playwright/test",
        "playwright",
        "@storybook/builder-vite"
      ]
    },
    "packages/shared-helpers": {
      "entry": [
        "src/index.{ts,tsx}",
        "index.{ts,tsx}",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "@12-apps/entity-lifecycle",
        "@12-apps/payments-backend",
        "@12-apps/product-research",
        "@12-apps/report-builder",
        "@12-apps/shift"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.{ts,tsx}",
        "index.{ts,tsx}"
      ]
    },
    "packages/payments/*": {
      "entry": [
        "src/index.{ts,tsx}",
        "index.{ts,tsx}"
      ]
    },
    "packages/payments/frontend": {
      "entry": [
        "src/index.ts",
        "// Stories are reached by .storybook/main.ts\u2019s glob, not by any",
        "// import \u2014 same shape as packages/ui\u2019s entry list.",
        "src/**/*.stories.{ts,tsx}",
        ".storybook/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@storybook/builder-vite"
      ]
    }
  },
  "vitest": {
    "config": [
      "vitest.config.ts"
    ]
  }
}
