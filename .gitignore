# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local / e2e PGlite data directories (file-backed WASM Postgres)
.e2e-db/
.dev-db/
*.pglite/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
*.tsbuildinfo


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
tasks
.data
.e2e-db-*/

# scripts/tunnel.sh working dir — frpc binary, generated config, logs, pids
.tunnel/

# Generated by scripts/harness-install.mjs from package.base.json.
harness/*/package.json
harness/*/dist
harness/*/test-results
harness/*/playwright-report
harness/*/package-lock.json
# Expo's own caches and the exports the native harness's tests read.
harness/native/.expo/
harness/native/web-build/

# Compiled Gherkin. `bddgen` rewrites it on every run of the harness suite;
# committing it would let a scenario and its compiled spec drift apart.
harness/*/.features-gen/

# The harness's Prisma schema folder is ASSEMBLED from the installed tarballs by
# harness/backend/prisma/sync-partials.ts, so every file in it except the host's
# own `schema.prisma` is a copy of a package's partial at whatever version is
# installed. Committing those copies would create a second source of truth that
# drifts from the tarball the tests actually run against — and drifts in the
# direction that matters, since Prisma would then generate a client for models
# the database does not have.
harness/backend/prisma/schema/*.prisma
!harness/backend/prisma/schema/schema.prisma
harness/backend/prisma/assembled.json

# Storybook build output
storybook-static/
storybook-native-static/
coverage-native/
